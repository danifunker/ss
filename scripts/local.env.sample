# Copy to scripts/local.env and fill in. local.env is gitignored: the
# repository carries no machine addresses, keys or personal paths.
#
#   cp scripts/local.env.sample scripts/local.env && $EDITOR scripts/local.env

# The MiSTer to deploy to. MISTER_SSH_KEY may be left empty to use the
# default ssh identity.
export MISTER_HOST="MiSTer.local"
export MISTER_SSH_USER="root"
export MISTER_SSH_KEY=""

# Top-level "_" folder the rbfs go into on the MiSTer.
export MISTER_CORE_FOLDER="_Unstable"

# Where Quartus 17.0.2 lives (the directory holding quartus_sh).
export QUARTUS_BIN="$HOME/intelFPGA_lite/17.0/quartus/bin"
